WECHAT_TOKEN=your_wechat_token_here
WECHAT_APPID=your_wechat_appid_here
WECHAT_SECRET=your_wechat_secret_here
EncodingAESKey=your_encoding_aes_key_here

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:32b-instruct-q4_K_M
OLLAMA_NUM_PREDICT=180
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_KEEP_ALIVE=30m
OLLAMA_WARMUP_ON_STARTUP=1
OLLAMA_WARMUP_TIMEOUT_SECONDS=15

PROMPT_PROFILE=web_helper
PROMPT_CONFIG_PATH=config/prompt.private.yaml
PROMPT_EXAMPLE_PATH=config/prompt.example.yaml
TOOL_CALL_CONFIDENCE_THRESHOLD=0.55

CONSTITUTION_SCORING_PATH=config/constitution_scoring.private.yaml
HERBAL_ADVICE_PATH=config/herbal_advice.private.yaml
LINK_INDEX_PATH=config/link_index.private.yaml
RUNTIME_LIMITS_PATH=config/runtime_limits.private.yaml
COMMERCE_GUARDRAIL_PATH=config/guardrail.private.yaml
QUESTIONNAIRE_CONFIG_PATH=config/questionnaire.private.yaml

PRODUCT_CATALOG_PATH=..\herbal_advice_product_demo\products.json
INGREDIENT_CATALOG_PATH=..\herbal_advice_product_demo\ingredients.json
ARTICLE_CONTENT_ROOT=..\herbal_advice_product_demo\content\articles

OPENCLAW_MEMORY_ENABLED=1
OPENCLAW_MEMORY_MAX_TURNS=4
OPENCLAW_MEMORY_TTL_SECONDS=1800
OPENCLAW_MEMORY_MAX_MESSAGE_CHARS=240
OPENCLAW_MEMORY_MAX_HISTORY_CHARS=1200
PRODUCT_HELPER_SESSION_TTL_SECONDS=1800

PORT=8787

WEBUI_HOST_BIND=127.0.0.1
WEBUI_HOST_PORT=8788
WEBUI_BASE_PATH=/ui/herbal_advice
WEBUI_TITLE=Herbal Tea Recommendation Helper
WEBUI_TITLE_ZH=草本茶推荐助手
WEBUI_TITLE_EN=Herbal Tea Recommendation Helper
WEBUI_WELCOME_MESSAGE_ZH=欢迎来到品牌 AI Helper。你可以告诉我最近的状态、送礼方向，或想先了解哪类草本茶。
WEBUI_WELCOME_MESSAGE_EN=Welcome to the brand AI helper. Share how you have been feeling, what you might want to gift, or the tea direction you want to explore.
WEBUI_API_BASE_URL=
WEBUI_INTAKE_CONFIG_PATH=config/questionnaire.private.yaml
WEBUI_CORS_ALLOWED_ORIGINS=

OPENCLAW_REPLY_TIMEOUT_SECONDS=8
WECHAT_SYNC_TIMEOUT_TEXT=系统繁忙，请稍后再试。
WECHAT_SYNC_ERROR_TEXT=服务暂时繁忙，请稍后再试。
